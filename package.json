{
  "name": "llm-playground",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "install:backends": "bash scripts/install-image-backends.sh",
    "backends:start": "bash scripts/start-image-backends.sh",
    "backends:stop": "bash scripts/stop-image-backends.sh",
    "dev:all": "node scripts/run-with-backends.mjs dev",
    "start:all": "node scripts/run-with-backends.mjs start"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
